rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && exists(
            /databases/$(database)/documents/admins/$(request.auth.uid)
          );
    }

    match /site_content/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /about/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /home/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contact/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /skills/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /skill_categories/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /colors/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cv_colors/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CV sections
    match /cv_sections/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null
          && request.auth.uid == uid;

      allow create: if false;

      allow update, delete: if isAdmin()
          && request.auth.uid == uid;
    }
  }
}